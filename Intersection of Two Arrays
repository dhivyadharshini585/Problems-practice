class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {
        HashSet<Integer> set1= new HashSet<>();
        HashSet<Integer> set2= new HashSet<>();

        for(int i : nums1){
            set1.add(i);
        }
        for(int i: nums2){
            set2.add(i);
        }
        List<Integer> list = new ArrayList<>();
        for(int i : set2){
            if(set1.contains(i)) list.add(i);
        }

        int s=list.size();
        int arr[] = new int[s];
        int a=0;
        for(int i : list){
            arr[a++]=i;
        }

        return arr;
    }
}
